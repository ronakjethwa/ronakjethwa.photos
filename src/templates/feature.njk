---
pagination:
    data: gallery
    size: 1
    alias: image
permalink: "/gallery/{{ image.title | slug }}/"
url: https://ronakjethwa.photos/gallery
cardType: summary_large_image
---
<!DOCTYPE html>
<html lang="en-US" dir="ltr">
    <head>
        {% set metaTitle = image.title %}
        {% set metaDesc = image.title + " " + site.pageMetadata.featured.content %}
        {% set metaUrl = site.url + page.url %}
        {% set metaImage = site.url + "/images/" + (image.src | variant(image.width)) %}
        {% set metaImageAlt = image.alt %}
        {% set metaCard = cardType %}
        {% set metaKeywords = "featured photography, gallery, images, Ronak Jethwa" %}
        {% include "layouts/meta.njk" %}
        {% set css %}
            {% include "css/style.css" %}
            {% include "css/reset.css" %}
        {% endset %}
        <style>
            {{ css | cssmin | safe }}
        </style>
    </head>
    <body>
        <a href="#main" class="skip-link">Skip to main content</a>
        {% include "layouts/nav.njk" %}
        <main id="main" class="main-container" role="main">
            <div class="featured-img">
                <div class="image-container">
                    {% respimg
                        src=image.src,
                        alt=image.alt,
                        sizes="(min-width: 1072px) 1024px, 100vw",
                        className="showcase-img",
                        eager=true
                    %}
                    <div class="image-description">
                        <h1 class="h2">{{ image.title }}</h1>
                        <p>{{ image.notes }}</p>
                        {# <p>{{ image.credit }} #}
                    </div>
                    <div class="prev-next">
                        {% if pagination.href.previous %}
                            <a class="prev" href="{{ pagination.href.previous }}"><span class="lt">&lt;</span> Prev</a>
                        {% endif %}
                        {% if pagination.href.next %}
                            {% if not pagination.href.previous %}
                            <a class="next" style="margin-left: auto; margin-right: 0;" href="{{ pagination.href.next }}">Next <span class="gt">&gt;</span></a>
                            {% else %}
                            <a class="next" href="{{ pagination.href.next }}">Next <span class="gt">&gt;</span></a>
                            {% endif %}
                        {% endif %}
                    </div>
                </div>
            </div>
        </main>
        {% include "layouts/footer.njk" %}
    </body>
</html>